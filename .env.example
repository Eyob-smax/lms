# Nx Configuration
NX_PREFER_NODE_STRIP_TYPES=false

# Better Auth & OAuth Secrets
BETTER_AUTH_SECRET=super-secret-better-auth-key-change-in-production-32chars
BETTER_AUTH_URL=http://localhost:3000

# Social OAuth Providers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Database Configuration
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=lms_password
POSTGRES_DB=lms_db
DATABASE_URL=postgresql://lms_user:lms_password@localhost:5432/lms_db?schema=public

# Application Ports & Environment
PORT=3000
NODE_ENV=development

# JWT Authentication Secrets
JWT_SECRET=super-secret-jwt-key-change-in-production-bpo-lms
JWT_EXPIRATION=7d

# OpenAI API Key (Optional for real LLM, mock fallback included)
OPENAI_API_KEY=your_openai_api_key_here
